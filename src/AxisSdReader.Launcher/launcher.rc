// Icon and version information for AxisSdReader.exe. version.h is generated by build.ps1.
#include <winver.h>
#include "version.h"

1 ICON "..\\AxisSdReader.App\\Assets\\AxisSDCardReader.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VER_MAJOR, VER_MINOR, VER_PATCH, 0
 PRODUCTVERSION VER_MAJOR, VER_MINOR, VER_PATCH, 0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "mrdnlabs"
            VALUE "FileDescription", "Axis SD Card Reader"
            VALUE "FileVersion", VER_STRING
            VALUE "InternalName", "AxisSdReader"
            VALUE "LegalCopyright", "Copyright (c) 2026 mrdnlabs"
            VALUE "OriginalFilename", "AxisSdReader.exe"
            VALUE "ProductName", "Axis SD Card Reader"
            VALUE "ProductVersion", VER_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
