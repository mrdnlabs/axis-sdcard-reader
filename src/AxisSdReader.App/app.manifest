<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.2.0.0" name="AxisSdReader.App"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!-- Raw disk access (\\.\PhysicalDriveN) and volume locking require elevation, but this exe never asks
             Windows for it: the .NET runtime would then start as administrator with the user's environment, which
             any program running as the user can set (profiler DLLs, dump paths). AxisSdReader.exe, the native
             launcher, is the elevated entry point: it starts this exe with a clean environment. Started directly,
             the app hands over to the launcher, or carries on without rights (card images need none). -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
